#!/usr/bin/env python3
"""Signs the user in to the rzilient platform for the Pulzar panel.

The panel cannot do this itself. Quickshell's Socket and SocketServer are
Unix-domain only — they take a `path`, not a host and port — so QML has no way
to serve the loopback redirect the authorization code comes back on, and no
SHA-256 for the PKCE challenge either. This helper owns both, and the panel
drives it with Process and reads a single line of JSON from stdout.

The platform registers the plugin as a public client: there is no secret, so
PKCE is what ties the code to the client that asked for it. The redirect goes
to an ephemeral loopback port, which Doorkeeper accepts because RFC 8252 §7.3
has it compare loopback URIs with the port removed.

Nothing secret is ever printed: stdout carries status, never a token.
"""

import base64
import errno
import hashlib
import http.server
import json
import os
import secrets
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

# One authorization server, two origins. The machine-facing half — the token
# and refresh exchanges — is the API. The human-facing half is the dashboard:
# the API answers /oauth/authorize with JSON, because a React consent card
# drives it, so sending a browser there shows a payload instead of a consent
# screen. The card lives at the dashboard origin, where the session is.
ISSUER = "https://api.rzilient.tech"
CONSENT_ORIGIN = "https://join.rzilient.club"
# The application is a device_agent, whose only permitted scope is this one.
# It is not a smaller external_api: a device_self token is refused by
# /api/external/v1/* on purpose, because those controllers scope by tenant
# rather than by person.
SCOPE = "device_self"

# The browser the authorize URL is handed to. Overridable so a test can point
# it at a stub that records its argv: the handoff to the desktop is otherwise
# the one step nothing exercises, which is how it shipped broken once.
OPENER = os.environ.get("PULZAR_OPENER") or "xdg-open"

# The tool the platform exposes to a device_self token, and the only one it can
# reach. Asking tools/list with this scope returns exactly this.
DEVICE_TOOL = "rzilient_my_device"
# The panel should not hang on a sign-in nobody is completing
WAIT_SECONDS = 180
HTTP_TIMEOUT = 30

STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state"),
    "rzilient-pulzar",
)
CREDENTIALS = os.path.join(STATE_DIR, "credentials.json")


def emit(**fields):
    """One line of JSON on stdout — the only thing the panel parses."""
    sys.stdout.write(json.dumps(fields) + "\n")
    sys.stdout.flush()


def fail(reason, detail=""):
    emit(ok=False, reason=reason, detail=detail)
    sys.exit(1)


# ----------------------------------------------------------------- storage

def ensure_state_dir():
    """Creates the directory 0700, refusing to follow a symlink into it.

    os.makedirs would happily walk a symlink an attacker planted, so the final
    component is created explicitly and then checked with lstat.
    """
    parent = os.path.dirname(STATE_DIR)
    os.makedirs(parent, mode=0o700, exist_ok=True)

    try:
        os.mkdir(STATE_DIR, 0o700)
    except FileExistsError:
        pass

    info = os.lstat(STATE_DIR)
    if not os.path.isdir(STATE_DIR) or os.path.islink(STATE_DIR):
        fail("state_dir_not_a_directory", STATE_DIR)
    if info.st_uid != os.getuid():
        fail("state_dir_not_owned_by_user", STATE_DIR)

    # Tighten a directory left loose by an older version
    if info.st_mode & 0o077:
        os.chmod(STATE_DIR, 0o700)


def save_credentials(payload):
    """Writes 0600 through a fresh temp file, then renames over the target.

    O_EXCL and O_NOFOLLOW mean the write cannot land on a symlink someone
    planted between the check and the open, and the rename is atomic, so a
    reader never sees a half-written file.
    """
    ensure_state_dir()
    temporary = CREDENTIALS + ".new"

    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass

    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
    handle = os.open(temporary, flags, 0o600)
    try:
        with os.fdopen(handle, "w") as stream:
            json.dump(payload, stream)
            stream.flush()
            os.fsync(stream.fileno())
    except BaseException:
        os.unlink(temporary)
        raise

    os.rename(temporary, CREDENTIALS)

    # The rename leaves the directory entry unflushed; a crash here would lose
    # a sign-in that already reported success
    directory = os.open(STATE_DIR, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)


def load_credentials():
    try:
        handle = os.open(CREDENTIALS, os.O_RDONLY | os.O_NOFOLLOW)
    except (FileNotFoundError, OSError) as error:
        if isinstance(error, OSError) and error.errno not in (errno.ENOENT, errno.ELOOP):
            raise
        return None

    with os.fdopen(handle) as stream:
        try:
            return json.load(stream)
        except ValueError:
            return None


# -------------------------------------------------------------------- pkce

def pkce_pair():
    """A verifier and its S256 challenge, base64url with the padding dropped.

    RFC 7636 §4.1 puts the verifier between 43 and 128 characters; 32 random
    bytes encode to 43.
    """
    verifier = base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip("=")
    digest = hashlib.sha256(verifier.encode("ascii")).digest()
    challenge = base64.urlsafe_b64encode(digest).decode().rstrip("=")
    return verifier, challenge


# --------------------------------------------------------------- listening

class Redirect(http.server.BaseHTTPRequestHandler):
    """Catches the one redirect and nothing else."""

    result = None
    expected_state = None

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)

        if parsed.path != "/callback":
            self.send_error(404)
            return

        query = urllib.parse.parse_qs(parsed.query)
        received_state = (query.get("state") or [""])[0]

        # A code arriving under someone else's state is not ours to use
        if not secrets.compare_digest(received_state, Redirect.expected_state or ""):
            Redirect.result = {"error": "state_mismatch"}
            self.respond("Sign-in could not be verified. You can close this tab.")
            return

        if "error" in query:
            Redirect.result = {"error": (query.get("error") or [""])[0]}
            self.respond("Sign-in was refused. You can close this tab.")
            return

        code = (query.get("code") or [""])[0]
        if not code:
            Redirect.result = {"error": "no_code"}
            self.respond("Sign-in returned no code. You can close this tab.")
            return

        Redirect.result = {"code": code}
        self.respond("Signed in. You can close this tab and go back to the panel.")

    def respond(self, message):
        body = ("<!doctype html><meta charset=utf-8>"
                "<title>Pulzar</title>"
                "<p style='font:16px system-ui;margin:3rem'>" + message + "</p>").encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *_args):
        """Silence: the default handler prints the query, code included."""


def listen():
    """Binds an ephemeral port on the loopback interface only."""
    server = http.server.HTTPServer(("127.0.0.1", 0), Redirect)
    server.timeout = 1
    return server, server.server_address[1]


# ------------------------------------------------------------------ tokens

def post_form(url, fields, on_invalid_grant=None):
    body = urllib.parse.urlencode(fields).encode()
    request = urllib.request.Request(
        url,
        data=body,
        method="POST",
        # enforce_content_type is on at the token endpoint
        headers={"Content-Type": "application/x-www-form-urlencoded",
                 "Accept": "application/json"},
    )

    try:
        with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT) as response:
            return json.loads(response.read().decode())
    except urllib.error.HTTPError as error:
        detail = ""
        try:
            detail = json.loads(error.read().decode()).get("error", "")
        except Exception:
            pass
        # A refresh token is spent the moment the access token issued beside it
        # is used, and a spent one answers invalid_grant. Retrying cannot help:
        # the user has to approve again.
        if detail == "invalid_grant" and on_invalid_grant:
            fail(on_invalid_grant, detail)
        fail("token_endpoint_%d" % error.code, detail)
    except urllib.error.URLError as error:
        fail("unreachable", str(error.reason))


def revoke_token(issuer, client_id, token):
    """Asks the platform to retire the token. Returns "" on success, else why not.

    Never fails the command. Signing out has to end with the person signed out
    locally whatever the network did, so this reports a problem rather than
    aborting before the credentials are removed.

    RFC 7009 §2.2 requires a 200 for a token the server does not recognise, so
    a 200 here is not proof that anything was revoked — only that the request
    was accepted. The test for this asserts the token stops working, not that
    the call returned 200.
    """
    body = urllib.parse.urlencode({"token": token, "client_id": client_id}).encode()
    request = urllib.request.Request(
        issuer.rstrip("/") + "/oauth/revoke",
        data=body,
        method="POST",
        headers={"Content-Type": "application/x-www-form-urlencoded",
                 "Accept": "application/json"},
    )

    try:
        with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT):
            return ""
    except urllib.error.HTTPError as error:
        return "revoke_%d" % error.code
    except urllib.error.URLError as error:
        return "unreachable: %s" % error.reason


def store(tokens):
    """Persists the pair, and says plainly when it could not.

    Rotation here is deferred: the refresh token just presented stays usable
    until the new access token is used for something. Nothing uses it between
    the exchange and this write, so a write that fails leaves the stored pair
    intact and still valid — the caller can simply try again. That is worth
    reporting as its own reason rather than as a traceback.
    """
    expires_in = tokens.get("expires_in")
    payload = {
        "access_token": tokens.get("access_token"),
        "refresh_token": tokens.get("refresh_token"),
        "scope": tokens.get("scope"),
        "token_type": tokens.get("token_type"),
        # Absolute, so the panel does not have to remember when it asked
        "expires_at": int(time.time()) + int(expires_in) if expires_in else None,
    }
    try:
        save_credentials(payload)
    except OSError as error:
        fail("cannot_store", "%s — the previous sign-in is still valid, try again" % error)

    return payload


# ---------------------------------------------------------------- commands

def login(issuer, client_id, consent_origin, open_browser=True):
    verifier, challenge = pkce_pair()
    state = secrets.token_urlsafe(24)
    Redirect.expected_state = state

    try:
        server, port = listen()
    except OSError as error:
        fail("cannot_listen", str(error))

    redirect_uri = "http://127.0.0.1:%d/callback" % port
    authorize = consent_origin.rstrip("/") + "/oauth/authorize?" + urllib.parse.urlencode({
        "client_id": client_id,
        "redirect_uri": redirect_uri,
        "response_type": "code",
        "scope": SCOPE,
        "state": state,
        "code_challenge": challenge,
        "code_challenge_method": "S256",
    })

    # The URL goes to the browser as one argv element. It used to go through
    # os.system, which hands the string to /bin/sh, and sh reads the first `&`
    # as the background operator: everything after client_id became shell
    # variable assignments and six of the seven parameters never arrived. The
    # consent page then correctly reported a malformed request. There is no
    # quoting to get right here, only a shell not to use.
    opened = True

    if open_browser:
        try:
            subprocess.Popen([OPENER, authorize],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            # Not fatal: the URL is in the line below, so the panel can still
            # offer it. Saying so beats a browser that silently never appears.
            opened = False

    emit(ok=True, stage="awaiting_consent", url=authorize,
         redirect_uri=redirect_uri, opened=opened)

    deadline = time.time() + WAIT_SECONDS
    while Redirect.result is None and time.time() < deadline:
        server.handle_request()
    server.server_close()

    if Redirect.result is None:
        fail("timed_out", "no redirect within %ds" % WAIT_SECONDS)
    if "error" in Redirect.result:
        fail(Redirect.result["error"])

    tokens = post_form(issuer.rstrip("/") + "/oauth/token", {
        "grant_type": "authorization_code",
        "code": Redirect.result["code"],
        "redirect_uri": redirect_uri,
        "client_id": client_id,
        "code_verifier": verifier,
    })

    stored = store(tokens)
    emit(ok=True, stage="signed_in", expires_at=stored["expires_at"], scope=stored["scope"])


def renew(issuer, client_id):
    """Exchanges the refresh token for a new pair and stores it. Returns it."""
    current = load_credentials()
    if not current or not current.get("refresh_token"):
        fail("not_signed_in")

    tokens = post_form(issuer.rstrip("/") + "/oauth/token", {
        "grant_type": "refresh_token",
        "refresh_token": current["refresh_token"],
        "client_id": client_id,
    }, on_invalid_grant="reauthorize_required")

    return store(tokens)


def refresh(issuer, client_id):
    stored = renew(issuer, client_id)
    emit(ok=True, stage="refreshed", expires_at=stored["expires_at"], scope=stored["scope"])


def status():
    current = load_credentials()
    if not current or not current.get("access_token"):
        emit(ok=True, signed_in=False)
        return

    expires_at = current.get("expires_at")
    emit(
        ok=True,
        signed_in=True,
        expires_at=expires_at,
        expired=bool(expires_at and expires_at <= time.time()),
        scope=current.get("scope"),
    )


# ------------------------------------------------------------------- device

def read_jsonrpc(body, content_type):
    """Reads one JSON-RPC answer out of a plain or event-stream response.

    The transport is streamable HTTP, so the server may answer either as plain
    JSON or as Server-Sent Events carrying the same object in a data: line.
    Both are correct; which one arrives is the server's choice, so neither can
    be assumed.
    """
    if "text/event-stream" in (content_type or ""):
        for line in body.splitlines():
            if line.startswith("data:"):
                payload = line[len("data:"):].strip()
                if payload:
                    return json.loads(payload)
        raise ValueError("no data: line in the event stream")

    return json.loads(body)


def call_tool(issuer, access_token, serial):
    """Calls the device tool. Returns (answer, status); never raises for HTTP."""
    body = json.dumps({
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {
            "name": DEVICE_TOOL,
            # Asking for json gives structuredContent, a parsed object, rather
            # than markdown that would have to be scraped
            "arguments": {"serial_number": serial, "response_format": "json"},
        },
    }).encode()

    request = urllib.request.Request(
        issuer.rstrip("/") + "/mcp",
        data=body,
        method="POST",
        headers={
            "Authorization": "Bearer " + access_token,
            "Content-Type": "application/json",
            # Streamable HTTP: the server picks one of these
            "Accept": "application/json, text/event-stream",
        },
    )

    try:
        with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT) as response:
            return (read_jsonrpc(response.read().decode(),
                                 response.headers.get("Content-Type")), 200)
    except urllib.error.HTTPError as error:
        error.read()
        return (None, error.code)
    except urllib.error.URLError as error:
        fail("unreachable", str(error.reason))
    except ValueError as error:
        fail("unreadable_answer", str(error))


def device(issuer, client_id, serial):
    current = load_credentials()

    if not current or not current.get("access_token"):
        fail("not_signed_in")

    expires_at = current.get("expires_at")
    if expires_at and expires_at <= time.time():
        current = renew(issuer, client_id)

    answer, status = call_tool(issuer, current["access_token"], serial)

    # A token can be revoked on the platform between the expiry check and the
    # call, so one 401 is worth a renewal — and exactly one. A second would be
    # a loop against a token the platform keeps refusing.
    if status == 401:
        current = renew(issuer, client_id)
        answer, status = call_tool(issuer, current["access_token"], serial)

    if status != 200:
        fail("device_lookup_%d" % status)

    if not isinstance(answer, dict) or "result" not in answer:
        fail("unreadable_answer", json.dumps(answer)[:200] if answer else "")

    result = answer["result"] or {}
    content = result.get("content") or []
    text = content[0].get("text", "") if content and isinstance(content[0], dict) else ""

    # A refusal arrives as a successful call. The one message deliberately
    # covers a serial the platform does not know, someone else's device and an
    # unassigned one alike, so it is passed through as written rather than
    # reworded into a certainty the platform did not express.
    if result.get("isError"):
        emit(ok=True, stage="device", found=False, message=text)
        return

    emit(ok=True, stage="device", found=True,
         device=result.get("structuredContent") or {})


def logout(issuer, client_id):
    """Forgets the token here, then retires it on the platform.

    Deleting the file alone would leave a credential that keeps working: the
    access token for up to two hours, and the refresh token until something
    uses it. A copy in a backup, a synced directory, or an undelete would still
    be live, so a sign-out that only unlinks tells the person something untrue.

    An access token and its refresh token are one row in Doorkeeper, so
    revoking the refresh token retires both in a single call.

    The local half happens first, and that ordering is the point. Revocation is
    a synchronous request with a thirty second timeout, and an endpoint that
    drops packets rather than refusing them will sit there for all of it. If
    the helper is killed during that wait — the panel closing, a session
    ending, someone giving up — then with the unlink last the credentials file
    survives and the person was never signed out at all, which is the one
    outcome a sign-out must never produce. The token is read into memory first,
    so the revocation still has what it needs after the file is gone.
    """
    current = load_credentials()
    token = (current or {}).get("refresh_token")

    try:
        os.unlink(CREDENTIALS)
    except FileNotFoundError:
        pass

    problem = ""

    if token and client_id:
        problem = revoke_token(issuer, client_id, token)
    elif token:
        problem = "no_client_id"

    emit(ok=True, signed_in=False, revoked=(bool(token) and problem == ""),
         revoke_failed=problem)


def main(argv):
    command = argv[1] if len(argv) > 1 else "status"
    issuer = os.environ.get("PULZAR_ISSUER") or ISSUER
    consent_origin = os.environ.get("PULZAR_CONSENT_ORIGIN") or CONSENT_ORIGIN
    client_id = os.environ.get("PULZAR_CLIENT_ID") or ""

    if command in ("login", "refresh", "device") and not client_id:
        fail("no_client_id", "set PULZAR_CLIENT_ID")

    if command == "login":
        login(issuer, client_id, consent_origin,
              open_browser=os.environ.get("PULZAR_NO_BROWSER") != "1")
    elif command == "refresh":
        refresh(issuer, client_id)
    elif command == "device":
        serial = argv[2] if len(argv) > 2 else ""
        if not serial:
            fail("no_serial")
        device(issuer, client_id, serial)
    elif command == "status":
        status()
    elif command == "logout":
        logout(issuer, client_id)
    else:
        fail("unknown_command", command)


if __name__ == "__main__":
    try:
        main(sys.argv)
    except KeyboardInterrupt:
        fail("interrupted")
